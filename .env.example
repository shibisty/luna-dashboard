APP_NAME=luna-dashboard
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
HTTP_ADDR=:8080
LOG_LEVEL=debug
# Swagger UI of the internal API at /internal/docs (the document is at /internal/openapi.yaml).
API_DOCS=true

# Behind nginx: the networks nginx connects from (CIDRs, addresses, "private", "loopback").
# HTTP_TRUSTED_PROXIES=172.18.0.0/16

DB_DRIVER=postgres
DATABASE_DSN=postgres://dashboard_user:dashboard_password@127.0.0.1:5433/dashboard?sslmode=require
# Run pending migrations at start (handy locally; use `go run . migrate` in production).
DB_MIGRATE=true

# Developers' sessions (table passport_sessions).
AUTH_SESSION_TTL=720h

# Tokens of the services that may introspect API keys (luna-auth, luna-pages), comma-separated.
LUNA_SERVICE_TOKENS=

# The users pages call luna-auth's internal API: its address and its LUNA_DASHBOARD_TOKEN
# (the same secret as luna-auth's entry in LUNA_SERVICE_TOKENS).
LUNA_AUTH_URL=http://localhost:8081
LUNA_AUTH_TOKEN=
