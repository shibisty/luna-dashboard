# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/nuxt_passport_app"

# --- Session ---
# Имя cookie и время жизни сессии (в днях)
SESSION_COOKIE_NAME="sid"
SESSION_TTL_DAYS=30

# --- SMTP (восстановление пароля) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@example.com"
SMTP_PASS="changeme"
SMTP_FROM="Passport App <no-reply@example.com>"

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# --- OAuth: Meta (Facebook) — добавляется по аналогии с Google, см. README ---
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# --- OAuth: X (Twitter) — добавляется по аналогии с Google, см. README ---
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# --- App ---
APP_URL="http://localhost:3000"
