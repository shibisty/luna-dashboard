{
    "name": "luna-dashboard",
    "version": "0.1.0",
    "private": true,
    "description": "Luna developer console: applications and their API keys; the key authority of the platform",
    "license": "MIT",
    "repository": "github:shibisty/luna-dashboard",
    "engines": {
        "go": ">=1.22"
    },
    "dependencies": {
        "fullstack": "github:shibisty/fullstack.go#^0.1",
        "fullstack-orm": "github:shibisty/fullstack.go-orm#^0.1",
        "fullstack-passport": "github:shibisty/fullstack.go-passport#^0.1",
        "fullstack-validation": "github:shibisty/fullstack.go-validation#^0.1",
        "luna-keys": "workspace:^0.1",
        "migration": "github:shibisty/migration.go#^0.1",
        "migration-orm": "github:shibisty/migration.go-orm-driver#^0.1",
        "orm": "github:shibisty/orm.go#^0.2",
        "orm-postgres": "github:shibisty/orm.go-postgres-driver#^0.1",
        "passport": "github:shibisty/passport.go#^0.2",
        "passport-local": "github:shibisty/passport.go-local-strategy#^0.1",
        "passport-session-sql": "github:shibisty/passport.go-sql-session#^0.1"
    },
    "devDependencies": {
        "fullstack-testing": "github:shibisty/fullstack.go-testing#^0.1"
    },
    "scripts": {
        "build": "go build -o build/luna-dashboard .",
        "db:seed": "go run . db:seed",
        "dev": "gtr dev",
        "migrate": "go run . migrate",
        "routes": "go run . routes:list",
        "test": "go test ./...",
        "test:integration": "go test -tags integration ./..."
    }
}
