generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String? // null для пользователей, пришедших только через OAuth
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  oauthAccounts OAuthAccount[]
  apiKeys ApiKey[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) // это и есть значение cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("sessions")
}

// Привязка внешних провайдеров (google / meta / x) к локальному пользователю
model OAuthAccount {
  id             String @id @default(uuid())
  provider       String // "google" | "meta" | "x"
  providerUserId String
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model ApiKey {
  id             String    @id @default(uuid())
  name           String
  publicKey      String    @unique
  privateKeyHash String
  allowedDomains String[]  @default([])
  allowedIps     String[]  @default([])
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}
